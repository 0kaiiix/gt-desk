{
  "entities": {
    "pedestals": {
      "title": "Pedestal",
      "description": "Office pedestals relocation records and slot assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "zone": { "type": "string" },
        "colIndex": { "type": "number" },
        "slotIndex": { "type": "number" },
        "userName": { "type": "string" },
        "customerId": { "type": "string" },
        "oldZone": { "type": "string" },
        "oldCol": { "type": "number" },
        "oldRow": { "type": "number" },
        "oldCode": { "type": "string" },
        "newLocation": { "type": "string" },
        "newCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "moved"] },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "zone", "colIndex", "slotIndex", "customerId", "oldCode", "newLocation", "status"]
    },
    "settings": {
      "title": "System Settings",
      "description": "System state metadata and versioning",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "totalCount": { "type": "number" }
      }
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
